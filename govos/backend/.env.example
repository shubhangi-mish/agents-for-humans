# Local dev: leave GOVOS_STORE unset (or "local") to use the zero-setup JSON file store.
# Cloud: set to "dynamodb" and make sure AWS credentials are configured (aws
# configure, or an execution role when running on App Runner/AgentCore).
GOVOS_STORE=local
GOVOS_TABLE=govos-incidents

# AWS region Bedrock + DynamoDB calls are made in. Make sure you've requested
# model access for the chosen Bedrock model in this region (Bedrock console ->
# Model access).
AWS_REGION=us-east-1

# Bedrock model id used by all Strands agents. Claude 3 Haiku is the
# cheapest Claude model on Bedrock; swap to a Sonnet/Opus cross-region
# inference profile ID for stronger reasoning at higher cost.
GOVOS_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# Only needed if you're not using `aws configure` / an execution role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model provider toggle: "bedrock" (default, AWS-native, scores higher on
# the hackathon's Technical Implementation rubric) or "openai" (cheaper,
# useful for dev-loop iteration — keep Bedrock for anything you record/submit).
GOVOS_MODEL_PROVIDER=bedrock
OPENAI_API_KEY=
GOVOS_OPENAI_MODEL_ID=gpt-4o-mini

# Live simulation: auto-starts a new incident at a random real location every
# N seconds, like a real weather/sensor feed would. Set to false for manual-only.
GOVOS_AUTO_TRIGGER=true
GOVOS_AUTO_TRIGGER_INTERVAL_SECONDS=90
