# Local dev: leave GOVOS_STORE unset (or "local") to use the zero-setup JSON file store.
# Cloud: set to "dynamodb" and make sure AWS credentials are configured (aws
# configure, or an execution role when running on App Runner/AgentCore).
GOVOS_STORE=local
GOVOS_TABLE=govos-incidents

# AWS region Bedrock + DynamoDB calls are made in. Make sure you've requested
# model access for the chosen Bedrock model in this region (Bedrock console ->
# Model access).
AWS_REGION=us-east-1

# Bedrock model id used by all Strands agents. Claude 3 Haiku is the
# cheapest Claude model on Bedrock; swap to a Sonnet/Opus cross-region
# inference profile ID for stronger reasoning at higher cost.
GOVOS_MODEL_ID=us.anthropic.claude-3-haiku-20240307-v1:0

# Only needed if you're not using `aws configure` / an execution role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model provider toggle: "bedrock" (default, AWS-native, scores higher on
# the hackathon's Technical Implementation rubric) or "openai" (cheaper,
# useful for dev-loop iteration — keep Bedrock for anything you record/submit).
GOVOS_MODEL_PROVIDER=bedrock
OPENAI_API_KEY=
GOVOS_OPENAI_MODEL_ID=gpt-4o-mini

# Delhi news feed (news_feed.py) — pulls real Google News headlines,
# geocodes each to a real lat/lng + district. On-demand by default: nothing
# polls automatically, the frontend's Refresh button calls POST
# /news/refresh which does one poll cycle. Set GOVOS_NEWS_FEED_BACKGROUND=true
# to instead have it poll itself on a timer (costs an LLM + geocoding call
# per new headline every cycle, whether or not anyone has the app open).
GOVOS_NEWS_FEED_BACKGROUND=false
GOVOS_NEWS_FEED_INTERVAL_SECONDS=180

# When a real news item genuinely names one of the response engine's five
# pilot wards (Satya Niketan, Safdarjung Enclave, Sarojini Nagar, Munirka,
# Hauz Khas), also run the full simulated task/approval response for it.
# Set to false to keep this app to real-news-pins-only, no simulation.
GOVOS_PILOT_SIM=true

# CALL-E sign-off calls (agents/signoff_call.py) — when a DDMA-tier action
# auto-authorizes itself, place a real phone call to the Chief Minister's own
# pre-registered number to confirm or override it. Requires Python 3.11+
# (see backend/.venv313) and `pip install calle-ai`. Safe by default: leave
# any of these three unset/false and nothing here ever places a real call —
# it logs what it would have said instead. Get an API key by installing
# CALL-E (see the hackathon's install guide) — never put a real emergency
# services or third-party number in CALLE_SIGNOFF_PHONE, only your own.
CALLE_API_KEY=
CALLE_SIGNOFF_PHONE=
CALLE_SIGNOFF_ENABLED=false
CALLE_SIGNOFF_ACTOR_NAME=Chief Minister, Government of NCT of Delhi
